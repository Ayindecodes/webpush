# WEB X-RAY configuration. Copy to .env for local development.
# Every setting maps to webxray/config.py (prefix WEBXRAY_).

WEBXRAY_ENVIRONMENT=development
WEBXRAY_DATABASE_URL=postgresql+asyncpg://webxray:webxray_dev_password@127.0.0.1:55432/webxray
WEBXRAY_REDIS_URL=redis://127.0.0.1:56379/0

# REQUIRED in production (the app refuses to start with the dev defaults):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBXRAY_SECRET_KEY=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBXRAY_CREDENTIAL_ENCRYPTION_KEY=
WEBXRAY_COOKIE_SECURE=false

# Exact origins allowed despite resolving to private/loopback addresses.
# Local benchmark only — leave EMPTY in production.
WEBXRAY_ALLOWED_PRIVATE_ORIGINS=http://127.0.0.1:4100

# Web origins allowed to make state-changing API calls (CSRF defence).
WEBXRAY_ALLOWED_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional
# WEBXRAY_ARTIFACT_DIR=.data/artifacts
# WEBXRAY_BROWSER_HEADLESS=true
# WEBXRAY_EGRESS_ALLOWED_PORTS=80,443,8080,8443
# WEBXRAY_LOG_LEVEL=INFO
